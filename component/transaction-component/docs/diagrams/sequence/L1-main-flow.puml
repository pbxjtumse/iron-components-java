@startuml
title Transaction - L1 REQUIRED Main Flow
actor Caller
participant DefaultTransactionExecutor as E
participant TransactionOptionsValidator as V
participant TransactionProvider as P
participant "Business Callback" as B
Caller -> E : execute(options, callback)
E -> V : validate(options)
E -> P : execute(options, providerCallback)
P -> B : callback(context)
B --> P : result
P --> E : result
E --> Caller : result
@enduml
