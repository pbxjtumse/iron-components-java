@startuml
title Concurrency Component - Component Overview
skinparam componentStyle rectangle
[concurrency-api] --> [concurrency-core]
[concurrency-config] --> [concurrency-api]
[concurrency-provider] --> [concurrency-api]
[concurrency-integrations] --> [concurrency-api]
[concurrency-starter] --> [concurrency-core]
[concurrency-starter] --> [concurrency-config]
[concurrency-starter] --> [concurrency-integrations]
[concurrency-demo] --> [concurrency-starter]
rectangle "core" {
 [DefaultTaskExecutionTemplate]
 [TaskCommand]
 [DefaultTaskResultPipeline]
 [DefaultThreadPoolManager]
 [DefaultTaskLifecyclePublisher]
}
rectangle "api" {
 [AsyncTask]
 [AsyncTemplate]
 [AsyncExecutor]
 [TaskHandle]
 [ThreadPoolManager]
}
@enduml
