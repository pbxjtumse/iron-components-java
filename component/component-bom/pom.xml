<?xml version='1.0' encoding='UTF-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.xjtu.iron</groupId>
        <artifactId>iron-components-java</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>component-bom</artifactId>
    <packaging>pom</packaging>
    <name>component-bom</name>
    <description>对外发布的技术组件版本清单；供业务工程通过 dependencyManagement/import 消费，不参与技术组件源码内部版本继承。</description>
    <dependencyManagement>
        <dependencies>
            <!-- 对外消费 BOM：当前发布所有可复用非 Demo JAR。源码内部构建版本由 component/pom.xml 管理。 -->
            <!-- cache-component -->
            <dependency>
                <groupId>com.xjtu.iron</groupId>
                <artifactId>cache-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.xjtu.iron</groupId>
                <artifactId>cache-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- concurrency-component -->
            <dependency>
                <groupId>com.xjtu.iron</groupId>
                <artifactId>concurrency-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- distributed-lock-component -->
            <dependency>
                <groupId>com.xjtu.iron</groupId>
                <artifactId>distributed-lock-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.xjtu.iron</groupId>
                <artifactId>distributed-lock-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- foundation-component -->
            <dependency>
                <groupId>com.xjtu.iron</groupId>
                <artifactId>foundation-codec</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- governance-component -->
            <dependency>
                <groupId>com.xjtu.iron</groupId>
                <artifactId>governance-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- idempotent-component -->
            <dependency>
                <groupId>com.xjtu.iron</groupId>
                <artifactId>idempotent-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- transaction-component -->
            <dependency>
                <groupId>com.xjtu.iron</groupId>
                <artifactId>transaction-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- message-component -->
            <dependency>
                <groupId>com.xjtu.iron</groupId>
                <artifactId>message-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- observability-component -->
            <dependency>
                <groupId>com.xjtu.iron</groupId>
                <artifactId>observability-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- retry-component -->
            <dependency>
                <groupId>com.xjtu.iron</groupId>
                <artifactId>retry-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- relational-access-component -->
            <dependency>
                <groupId>com.xjtu.iron</groupId>
                <artifactId>relational-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.xjtu.iron</groupId>
                <artifactId>relational-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
