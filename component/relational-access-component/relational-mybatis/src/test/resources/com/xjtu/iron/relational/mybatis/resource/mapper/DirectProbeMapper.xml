<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xjtu.iron.relational.mybatis.resource.DirectProbeMapper">
    <select id="selectMarker" resultType="java.lang.String">
        SELECT marker FROM direct_probe WHERE id = 1
    </select>
    <update id="updateMarker">
        UPDATE direct_probe SET marker = #{marker} WHERE id = 1
    </update>
</mapper>
