@startuml
title Relational Access - L0 Overview
actor Caller
participant RelationalTemplate as T
participant ConnectionProvider as C
database Database as DB
Caller -> T : query/update/batch
T -> C : acquire(SqlExecutionContext)
C --> T : ConnectionHandle
T -> DB : PreparedStatement execution
DB --> T : ResultSet / update count
T --> Caller : mapped result
@enduml
