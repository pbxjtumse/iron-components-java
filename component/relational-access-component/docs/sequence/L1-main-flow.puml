@startuml
title Relational Access - L1 Main SQL Flow
actor Caller
participant DefaultRelationalTemplate as T
participant SqlStatementValidator as V
participant ConnectionProvider as CP
participant JdbcStatementConfigurer as SC
participant JdbcParameterBinder as PB
participant RowMapper as RM
database DB

Caller -> T : queryOne(statement, mapper)
T -> V : validate(statement)
T -> CP : acquire(context)
CP --> T : ConnectionHandle
T -> DB : prepareStatement
T -> SC : configure(options)
T -> PB : bind(parameters)
T -> DB : executeQuery
DB --> T : ResultSet
T -> RM : map(row)
RM --> T : value
T -> T : close ResultSet/Statement/Handle
T --> Caller : Optional<T>
@enduml
