@startuml
title Relational Access v1 - batchUpdate() Flow

autonumber
skinparam shadowing false

actor "JdbcOutboxStorage / JdbcTaskStorage" as Storage
participant "DefaultRelationalTemplate" as RT
participant "ConnectionProvider" as CP
participant "ConnectionHandle" as Handle
participant "JdbcStatementConfigurer" as Configurer
participant "JdbcParameterBinder" as Binder
participant "PreparedStatement" as PS
database Database as DB

Storage -> RT : batchUpdate(BatchSqlStatement)
RT -> RT : validate()\ncreateExecutionContext(BATCH_UPDATE)
RT -> CP : acquire(context)
CP --> RT : ConnectionHandle
RT -> Handle : connection()
RT -> PS : prepareStatement(fixed sql)
RT -> Configurer : configure(PS, options)

loop every parameter group
  RT -> Binder : bind(PS, batchParameters)
  RT -> PS : addBatch()
end

RT -> PS : executeBatch()
PS -> DB : batch SQL
DB --> PS : int[] updateCounts
PS --> RT : int[]
RT -> PS : close()
RT -> Handle : close()
RT --> Storage : BatchResult(defensive copy)

note right of RT
ExecutionContext contains:
- operationName
- sql operation type
- route
- options
end note

@enduml
