@startuml
title Consume Full State - Direct Enum Names From Code

' 状态图保持默认黑白，不引入模块颜色。

legend right
  代码枚举节点直接显示真实来源：枚举类.枚举值
  示例：ConsumeDecision.ACK / SendFailureType.VALIDATION_ERROR
  LOGICAL = 查询、时间、次数、配置推导，代码枚举中不存在
  RUNTIME = 执行过程节点，代码枚举中不存在
  ACTION = repository / adapter 动作，不是状态枚举
  PROVIDER ACTION = Kafka / Pulsar / RocketMQ 原生确认动作
  PROVIDER CAUSE = Provider 原生返回或异常，不是统一状态枚举
  MESSAGE SEMANTIC = message-component 语义，目前不是持久化枚举
endlegend

state "PROVIDER_RECEIVED\nRUNTIME\nnative consumer receives message" as R_PROVIDER_RECEIVED
state "INBOUND_CREATED\nRUNTIME\nProviderInboundMessage built" as R_INBOUND_CREATED
state "CONSUMER_RESOLVING\nRUNTIME\nConsumerDefinitionRegistry.find(...)" as R_CONSUMER_RESOLVING
state "CONSUMER_MISSING\nLOGICAL\nno ConsumerDefinition found" as L_CONSUMER_MISSING
state "DECODING\nRUNTIME\nMessageWireCodec.decode(...)" as R_DECODING
state "DECODE_FAILED\nLOGICAL\ndecode exception / incompatible wire" as L_DECODE_FAILED
state "CONTEXT_CREATED\nRUNTIME\nDefaultConsumeContextFactory.create(...)" as R_CONTEXT_CREATED

state "IDEMPOTENCY_DISABLED\nLOGICAL\nMessageIdempotencyOptions.enabled=false" as L_IDEMPOTENCY_DISABLED
state "IDEMPOTENCY_CHECKING\nRUNTIME\nMessageIdempotencyExecutor.execute(...)" as R_IDEMPOTENCY_CHECKING

state "ACQUIRED\nIdempotentAcquireStatus.ACQUIRED" as A_ACQUIRED
state "DUPLICATE_SUCCESS\nIdempotentAcquireStatus.DUPLICATE_SUCCESS" as A_DUPLICATE_SUCCESS
state "DUPLICATE_DISCARDED\nIdempotentAcquireStatus.DUPLICATE_DISCARDED" as A_DUPLICATE_DISCARDED
state "PROCESSING\nIdempotentAcquireStatus.PROCESSING" as A_PROCESSING
state "REJECTED\nIdempotentAcquireStatus.REJECTED" as A_REJECTED
state "STORAGE_ERROR\nIdempotentAcquireStatus.STORAGE_ERROR" as A_STORAGE_ERROR

state "PROCESSING\nIdempotencyStatus.PROCESSING" as DB_PROCESSING
state "SUCCESS\nIdempotencyStatus.SUCCESS" as DB_SUCCESS
state "FAILED\nIdempotencyStatus.FAILED" as DB_FAILED
state "DISCARDED\nIdempotencyStatus.DISCARDED" as DB_DISCARDED

state "TRANSACTION_RUNNING\nRUNTIME\nTransactionStrategy.execute(...)" as R_TX_RUNNING
state "HANDLER_EXECUTING\nRUNTIME\nMessageHandler.handle(...)" as R_HANDLER_EXECUTING
state "HANDLER_ACK\nRUNTIME\nhandler returns ConsumeDecision.ACK" as R_HANDLER_ACK
state "HANDLER_RETRY\nRUNTIME\nhandler returns ConsumeDecision.RETRY" as R_HANDLER_RETRY
state "HANDLER_DISCARD\nRUNTIME\nhandler returns ConsumeDecision.DISCARD" as R_HANDLER_DISCARD
state "HANDLER_EXCEPTION\nRUNTIME\nhandler throws exception" as R_HANDLER_EXCEPTION
state "MARK_SUCCESS\nRUNTIME\noperations.markSuccess(ownerToken)" as R_MARK_SUCCESS
state "MARK_FAILED\nRUNTIME\noperations.markFailed(ownerToken) best effort" as R_MARK_FAILED
state "MARK_DISCARDED\nRUNTIME\noperations.markDiscarded(ownerToken)" as R_MARK_DISCARDED
state "TRANSACTION_COMMITTED\nRUNTIME\nlocal transaction committed" as R_TX_COMMITTED
state "TRANSACTION_ROLLED_BACK\nRUNTIME\nlocal transaction rolled back" as R_TX_ROLLED_BACK

state "ACK\nConsumeDecision.ACK" as D_ACK
state "RETRY\nConsumeDecision.RETRY" as D_RETRY
state "DISCARD\nConsumeDecision.DISCARD" as D_DISCARD
state "DEAD_LETTER\nConsumeDecision.DEAD_LETTER" as D_DEAD_LETTER

state "RETRY_POLICY\nMessageIdempotencyFailurePolicy.RETRY" as P_FAILURE_RETRY
state "DISCARD_POLICY\nMessageIdempotencyFailurePolicy.DISCARD" as P_FAILURE_DISCARD
state "DEAD_LETTER_POLICY\nMessageIdempotencyFailurePolicy.DEAD_LETTER" as P_FAILURE_DLQ

state "PROVIDER_ACK\nPROVIDER ACTION\nKafka commit / Pulsar ack / RocketMQ success" as P_PROVIDER_ACK
state "PROVIDER_RETRY\nPROVIDER ACTION\nKafka no commit / Pulsar negativeAck / RocketMQ reconsume" as P_PROVIDER_RETRY

[*] --> R_PROVIDER_RECEIVED
R_PROVIDER_RECEIVED --> R_INBOUND_CREATED
R_INBOUND_CREATED --> R_CONSUMER_RESOLVING
R_CONSUMER_RESOLVING --> L_CONSUMER_MISSING : missing
L_CONSUMER_MISSING --> D_RETRY : missing-consumer.decision=RETRY
L_CONSUMER_MISSING --> D_DISCARD : missing-consumer.decision=DISCARD
R_CONSUMER_RESOLVING --> R_DECODING : found
R_DECODING --> L_DECODE_FAILED : decode exception
L_DECODE_FAILED --> D_RETRY : decode-failure.decision=RETRY
L_DECODE_FAILED --> D_DISCARD : decode-failure.decision=DISCARD
R_DECODING --> R_CONTEXT_CREATED : decoded MessageEnvelope

R_CONTEXT_CREATED --> L_IDEMPOTENCY_DISABLED : idempotency disabled
R_CONTEXT_CREATED --> R_IDEMPOTENCY_CHECKING : idempotency enabled
L_IDEMPOTENCY_DISABLED --> R_TX_RUNNING : invoke handler directly through template

R_IDEMPOTENCY_CHECKING --> A_ACQUIRED : operations.acquire(...)
R_IDEMPOTENCY_CHECKING --> A_DUPLICATE_SUCCESS : operations.acquire(...)
R_IDEMPOTENCY_CHECKING --> A_DUPLICATE_DISCARDED : operations.acquire(...)
R_IDEMPOTENCY_CHECKING --> A_PROCESSING : operations.acquire(...)
R_IDEMPOTENCY_CHECKING --> A_REJECTED : operations.acquire(...)
R_IDEMPOTENCY_CHECKING --> A_STORAGE_ERROR : operations.acquire(...)

A_ACQUIRED --> DB_PROCESSING : idempotent record owned by current ownerToken
DB_PROCESSING --> R_TX_RUNNING
A_DUPLICATE_SUCCESS --> D_ACK : skip handler
A_DUPLICATE_DISCARDED --> D_ACK : skip handler
A_PROCESSING --> D_RETRY : another owner is processing
A_STORAGE_ERROR --> D_RETRY : do not bypass idempotency
A_REJECTED --> P_FAILURE_RETRY : failurePolicy=RETRY
A_REJECTED --> P_FAILURE_DISCARD : failurePolicy=DISCARD
A_REJECTED --> P_FAILURE_DLQ : failurePolicy=DEAD_LETTER
P_FAILURE_RETRY --> D_RETRY
P_FAILURE_DISCARD --> R_MARK_DISCARDED
P_FAILURE_DLQ --> D_DEAD_LETTER : v13 reserved

R_TX_RUNNING --> R_HANDLER_EXECUTING
R_HANDLER_EXECUTING --> R_HANDLER_ACK
R_HANDLER_EXECUTING --> R_HANDLER_RETRY
R_HANDLER_EXECUTING --> R_HANDLER_DISCARD
R_HANDLER_EXECUTING --> R_HANDLER_EXCEPTION

R_HANDLER_ACK --> R_MARK_SUCCESS
R_MARK_SUCCESS --> DB_SUCCESS : markSuccess success
DB_SUCCESS --> R_TX_COMMITTED
R_MARK_SUCCESS --> R_TX_ROLLED_BACK : markSuccess failed / stale owner

R_HANDLER_DISCARD --> R_MARK_DISCARDED
R_MARK_DISCARDED --> DB_DISCARDED : markDiscarded success semantic
DB_DISCARDED --> R_TX_COMMITTED
R_MARK_DISCARDED --> R_TX_ROLLED_BACK : markDiscarded failed

R_HANDLER_RETRY --> R_TX_ROLLED_BACK : internal retry exception
R_HANDLER_EXCEPTION --> R_TX_ROLLED_BACK
R_TX_ROLLED_BACK --> R_MARK_FAILED
R_MARK_FAILED --> DB_FAILED : markFailed success
R_MARK_FAILED --> D_RETRY : markFailed failed, still retry
DB_FAILED --> D_RETRY

R_TX_COMMITTED --> D_ACK : handler ACK + SUCCESS stored
R_TX_COMMITTED --> D_DISCARD : handler DISCARD + discarded semantic stored

D_ACK --> P_PROVIDER_ACK
D_DISCARD --> P_PROVIDER_ACK
D_RETRY --> P_PROVIDER_RETRY

P_PROVIDER_ACK --> [*]
P_PROVIDER_RETRY --> [*]
D_DEAD_LETTER --> [*] : reserved

note right of P_PROVIDER_ACK
  Provider 直接根据 ProviderConsumeResult.decision().shouldAcknowledge() 执行原生确认动作。
  Kafka commit next offset，Pulsar acknowledge，RocketMQ CONSUME_SUCCESS。
end note

note right of DB_DISCARDED
  当前 idempotent-component 已正式持久化 IdempotencyStatus.DISCARDED。
  message-component 的 markDiscarded(...) 与 DUPLICATE_DISCARDED
  对应该终态。
end note
@enduml
