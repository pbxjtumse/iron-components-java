@startuml
!include ../../_common/style.puml

title External JDBC Fencing Flow - Lock Provider and Token Provider
autonumber
skinparam shadowing false

actor Caller

box "distributed-lock-api" #D9EAF7
participant "DistributedLockClient" as Client
end box

box "distributed-lock-core" #DFF2BF
participant "DefaultDistributedLockClient" as DefaultClient
participant "LockExecutionTemplate" as Template
participant "LockAcquisitionService" as Acquire
participant "FencingTokenCoordinator" as Coordinator
participant "ExternalFencingTokenFlow" as ExternalFlow
participant "FencingTokenProvider" as TokenProvider
participant "LockHandleFactory" as Factory
end box

box "distributed-lock-spi" #FFF2CC
participant "LockProvider" as LockProvider
end box

box "distributed-lock-provider-redis" #FFE6CC
participant "RedisLockProvider" as RedisProvider
end box

box "distributed-lock-fencing-provider-mybatis" #FFE6CC
participant "MyBatisSequenceFencingTokenProvider" as JdbcProvider
database "FencingDB" as FencingDB
end box

Caller -> Client : tryLock/execute(fencingRequired=true)
Client -> DefaultClient : delegate
DefaultClient -> Template : execute()
Template -> Acquire : acquire()

Acquire -> LockProvider : acquire(request)
LockProvider -> RedisProvider : acquire(request without fencing token)
RedisProvider --> LockProvider : ACQUIRED lease
LockProvider --> Acquire : lease

Acquire -> Coordinator : applyFencing(lease, options)
Coordinator -> ExternalFlow : issueToken(context)
ExternalFlow -> TokenProvider : nextToken(namespace, lockName, ownerToken)
TokenProvider -> JdbcProvider : nextToken(request)
JdbcProvider -> FencingDB : select/update sequence
FencingDB --> JdbcProvider : token=N
JdbcProvider --> TokenProvider : FencingTokenResponse(ISSUED, N)
TokenProvider --> ExternalFlow : token=N
ExternalFlow --> Coordinator : lease.withFencingToken(N)
Coordinator --> Acquire : fenced lease

Acquire -> Factory : create(fenced lease)
Factory --> Acquire : LockHandle
Acquire --> Template : LockHandle
Template --> DefaultClient : LockResult(ACQUIRED)
DefaultClient --> Client : result
Client --> Caller : result

@enduml
