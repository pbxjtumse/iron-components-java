@startuml
!include ../../_common/style.puml

title Fencing Provider Error Scenario - Release After Token Failure
autonumber
skinparam shadowing false

actor Caller

box "distributed-lock-api" #D9EAF7
participant "DistributedLockClient" as Client
end box

box "distributed-lock-core" #DFF2BF
participant "DefaultDistributedLockClient" as DefaultClient
participant "LockExecutionTemplate" as Template
participant "LockAcquisitionService" as Acquire
participant "FencingTokenCoordinator" as Coordinator
participant "FencingTokenProvider" as TokenProvider
participant "LockMetricsFacade" as Metrics
participant "LockEventPublisher" as Events
end box

box "distributed-lock-spi" #FFF2CC
participant "LockProvider" as LockProvider
end box

box "distributed-lock-provider-redis" #FFE6CC
participant "RedisLockProvider" as RedisProvider
end box

box "distributed-lock-fencing-provider-mybatis" #FFE6CC
participant "MyBatisSequenceFencingTokenProvider" as JdbcProvider
database "FencingDB" as DB
end box

Caller -> Client : execute(fencingRequired=true)
Client -> DefaultClient : delegate
DefaultClient -> Template : execute()
Template -> Acquire : acquire()

Acquire -> LockProvider : acquire(request)
LockProvider -> RedisProvider : acquire(request)
RedisProvider --> LockProvider : ACQUIRED lease
LockProvider --> Acquire : lease

Acquire -> Coordinator : issue token
Coordinator -> TokenProvider : nextToken(request)
TokenProvider -> JdbcProvider : nextToken(request)
JdbcProvider -> DB : select/update sequence
DB --> JdbcProvider : error
JdbcProvider --> TokenProvider : PROVIDER_ERROR
TokenProvider --> Coordinator : PROVIDER_ERROR
Coordinator --> Acquire : fencing failed

Acquire -> LockProvider : release(lease) as compensation
LockProvider -> RedisProvider : release(request)
RedisProvider --> LockProvider : RELEASED / NOT_OWNER / ERROR
LockProvider --> Acquire : release result

Acquire -> Metrics : recordFencing(success=false)
Acquire -> Events : publish FENCING_TOKEN_FAILED
Acquire --> Template : LockResult(PROVIDER_ERROR, FENCING)
Template --> DefaultClient : result
DefaultClient --> Client : result
Client --> Caller : token failure

@enduml
