@startuml
title Idempotent Component - L0
skinparam componentStyle rectangle
actor Caller
rectangle "idempotent-api" {
  [IdempotencyExecutor]
  [IdempotencyOperations]
  [IdempotencyRequest]
  [IdempotencyPolicy]
  [IdempotencyResultPolicy<T>]
  [IdempotencyRecoveryPolicy]
}
rectangle "idempotent-core" {
  [DefaultIdempotencyExecutor]
  [IdempotencyExecutionPreparer]
  [IdempotencyStateOperationExecutor]
  [IdempotencyBusinessExecutor]
  [DefaultIdempotencyStateMachine]
  [RepositoryRegistry]
}
rectangle "providers" {
  [RedisIdempotencyRepository]
  [JdbcIdempotencyRepository]
  [RoutedJdbcIdempotencyRepository]
}
rectangle "integrations" {
  [StorageRouteAwareIdempotencyExecutor]
  [StorageRouteAwareIdempotencyTransactionCoordinator]
  [TransactionTemplateIdempotencyTransactionCoordinator]
}
rectangle "external infrastructure" {
  [Storage Routing]
  [Transaction Component]
  [Distributed Lock optional]
  [Reliable Recovery Task]
}
Caller --> [IdempotencyExecutor]
[IdempotencyExecutor] --> [StorageRouteAwareIdempotencyExecutor] : route-aware enabled
[StorageRouteAwareIdempotencyExecutor] --> [DefaultIdempotencyExecutor]
[DefaultIdempotencyExecutor] --> [IdempotencyExecutionPreparer]
[DefaultIdempotencyExecutor] --> [IdempotencyStateOperationExecutor]
[DefaultIdempotencyExecutor] --> [DefaultIdempotencyStateMachine]
[DefaultIdempotencyExecutor] --> [IdempotencyBusinessExecutor]
[RepositoryRegistry] --> [RedisIdempotencyRepository]
[RepositoryRegistry] --> [JdbcIdempotencyRepository]
[RepositoryRegistry] --> [RoutedJdbcIdempotencyRepository]
[StorageRouteAwareIdempotencyExecutor] ..> [Storage Routing]
[StorageRouteAwareIdempotencyTransactionCoordinator] ..> [Transaction Component]
[DefaultIdempotencyExecutor] ..> [Distributed Lock optional]
[Reliable Recovery Task] --> [IdempotencyExecutor] : recover()
@enduml
