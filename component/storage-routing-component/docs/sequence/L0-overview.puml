@startuml
title Storage Routing - L0 Overview
actor Caller
participant StorageRouteResolver as R
participant StorageRouteContext as C
participant StorageRouteToSqlRouteBridge as B
participant RelationalTemplate as SQL
Caller -> R : resolve(RouteContext)
R --> Caller : StorageRoute
Caller -> C : open(route)
Caller -> B : route -> SqlRoute/table
B --> Caller : executable SQL routing info
Caller -> SQL : execute routed statement
Caller -> C : close scope
@enduml
