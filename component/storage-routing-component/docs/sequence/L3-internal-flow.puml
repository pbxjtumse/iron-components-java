@startuml
title Storage Routing - L3 Resolver Internal Flow
participant DefaultStorageRouteResolver as R
participant RouteContext as C
participant CompositeShardKey as K
participant ShardResolver as S
participant RouteMappingStrategy as M
participant StorageRoute as SR

R -> C : requireShardKey()
C --> R : K
R -> S : resolve(K)
S --> R : ShardRouteInfo
R -> M : map(ShardRouteInfo)
M --> R : PhysicalStorageLocation
R -> SR : builder().context(C).shardInfo(...).location(...)
SR --> R : immutable StorageRoute
@enduml
